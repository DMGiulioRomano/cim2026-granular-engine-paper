*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!templates/*.pdf
# PDF esempi (score/waveform/spectrogram) NON tracciati: rendering stocastico.
# paper.tex li include come figure -> `make examples` prima di `make paper`
# (examples è prerequisito del target paper). Distribuiti su Zenodo.
.venv/

# Audio degli esempi: tracciato su Zenodo, non in git
*.aif
*.wav

# Fonti web (snapshot HTML/TXT) in raw/papers: immutabili e non tracciate,
# come i PDF (es. articolo+manuale CMask di Bartetzki)
raw/papers/*.html
raw/papers/*.txt

# graphify runtime artifacts (GRAPH_REPORT.md e wiki/ restano tracciati)
context/*/graphify-out/graph.json
context/*/graphify-out/graph.html
context/*/graphify-out/cache/
context/*/graphify-out/cost.json
context/*/graphify-out/manifest.json

# OS / editor
.DS_Store

# Claude Code runtime state
.claude/

# Directory for Workflow add-paper
inbox/

.vscode/